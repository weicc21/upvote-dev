version: "1.0"

contexts:
  # Shared fallback — applied to any prompt not matched by a context below,
  # and as the base for the per-area defaults.
  default:
    defaults:
      generate_output_path: "pdd/"
      test_output_path: "tests/"
      example_output_path: "context/"
      default_language: "python"
      strength: 0.818
      temperature: 0.0
      target_coverage: 80.0
      budget: 10.0
      max_attempts: 3

  # Shared — the frozen vocabulary and settings every service imports.
  # Output mirrors the prompt tree relative to prompts/shared/:
  #   prompts/shared/constants_python.prompt -> shared/constants.py
  #   prompts/shared/config_python.prompt    -> shared/config.py
  # openapi.yaml is a frozen asset (reference/context only — never generated).
  shared:
    paths:
      - "prompts/shared/**"
    defaults:
      generate_output_path: "shared/"
      test_output_path: "shared/tests/"
      example_output_path: "prompts/shared/"
      default_language: "python"
      strength: 0.818
      temperature: 0.0
      target_coverage: 80.0
      budget: 10.0
      max_attempts: 3

  # Forum Frontend — TypeScript React prompts (prompts/frontend/**).
  # Output mirrors the prompt tree relative to prompts/frontend/ under
  # generate_output_path (PDD subpath mirroring):
  #   prompts/frontend/app_shell_typescriptreact.prompt        -> frontend/src/app_shell.tsx
  #   prompts/frontend/api_client_typescript.prompt            -> frontend/src/api_client.ts
  #   prompts/frontend/components/*_typescriptreact.prompt     -> frontend/src/components/*.tsx
  frontend:
    paths:
      - "prompts/frontend/**"
    defaults:
      generate_output_path: "frontend/src/"
      test_output_path: "frontend/src/__tests__/"
      example_output_path: "frontend/src/examples/"
      default_language: "typescriptreact"
      strength: 0.818
      temperature: 0.0
      target_coverage: 80.0
      budget: 10.0
      max_attempts: 3

  # Forum Backend API — Python prompts (prompts/backend/**)
  #   prompts/backend/main_python.prompt            -> backend/main.py
  #   prompts/backend/deps_python.prompt            -> backend/deps.py
  #   prompts/backend/routes/*_python.prompt        -> backend/routes/*.py
  backend:
    paths:
      - "prompts/backend/**"
    defaults:
      generate_output_path: "backend/"
      test_output_path: "backend/tests/"
      example_output_path: "backend/context/"
      default_language: "python"
      strength: 0.818
      temperature: 0.0
      target_coverage: 80.0
      budget: 10.0
      max_attempts: 3

  # Orchestration — Python agent/service prompts
  # (prompts/orchestration/*_python.prompt, with templates/ system prompts)
  # → orchestrator/
  orchestration:
    paths:
      - "prompts/orchestration/**"
    defaults:
      generate_output_path: "orchestrator/"
      test_output_path: "orchestrator/tests/"
      example_output_path: "orchestrator/context/"
      default_language: "python"
      strength: 0.818
      temperature: 0.0
      target_coverage: 80.0
      budget: 10.0
      max_attempts: 3
