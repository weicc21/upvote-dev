<pdd-reason>The backend's single dependency-injection seam: the providers every route imports and every test overrides.</pdd-reason>

<pdd-interface>
{"type":"module","module":{"functions":[
  {"name":"get_settings","signature":"def get_settings() -> Settings","returns":"the shared Settings instance"},
  {"name":"get_supabase","signature":"async def get_supabase() -> AsyncClient","returns":"Supabase async client; raises until bound"},
  {"name":"get_redis","signature":"async def get_redis() -> redis.asyncio.Redis","returns":"async Redis client; raises until bound"},
  {"name":"get_current_user_id","signature":"def get_current_user_id(request: Request) -> str","returns":"caller id; 401 when absent"},
  {"name":"get_optional_user_id","signature":"def get_optional_user_id(request: Request) -> str | None","returns":"caller id, or None"},
  {"name":"ErrorResponse","signature":"class ErrorResponse(BaseModel)","returns":"the frozen {error:{code,message}} envelope"},
