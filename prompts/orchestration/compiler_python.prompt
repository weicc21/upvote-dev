<pdd-reason>The step that makes the whole product true. Everything before it is opinion; this is where a community vote becomes source code in a real repository, with no human reading the diff.</pdd-reason>

<pdd-interface>
{"type":"module","module":{"functions":[
  {"name":"CompileOutcome","signature":"@dataclass(frozen=True) class CompileOutcome","returns":"feature_id: str; ok: bool; version_hash: str | None; summary: str; log_tail: str; duration_s: float"},
  {"name":"Runner","signature":"Runner = Callable[[str, Path, Mapping[str, str]], Awaitable[tuple[int, str, str]]]","returns":"injected seam: (command, cwd, env) -> (returncode, stdout, stderr)"},
  {"name":"build_feature_block","signature":"def build_feature_block(feature: Mapping[str, Any]) -> str","returns":"the text appended to the target prompt for one feature"},
  {"name":"compile_feature","signature":"async def compile_feature(feature: Mapping[str, Any], supabase: AsyncClient, redis: Redis, *, runner: Runner | None = None) -> CompileOutcome","returns":"append, compile, and resolve one feature"},
  {"name":"compile_next","signature":"async def compile_next(supabase: AsyncClient, redis: Redis, *, runner: Runner | None = None) -> CompileOutcome | None","returns":"compile the oldest IN_SPRINT feature, or None when there is none"},
