<pdd-reason>The last unautomated step. A compile leaves new source on a disk; this pushes it, waits for the platform to actually serve it, and tells the system it is live — without holding the sprint hostage while a build runs.</pdd-reason>

<pdd-interface>
{"type":"module","module":{"functions":[
  {"name":"PublishOutcome","signature":"@dataclass(frozen=True) class PublishOutcome","returns":"ok: bool; commit_sha: str | None; deploy_id: str | None; status: str; detail: str"},
  {"name":"HttpGet","signature":"HttpGet = Callable[[str, Mapping[str, str]], Awaitable[tuple[int, str]]]","returns":"injected seam: (url, headers) -> (status, body)"},
  {"name":"HttpPost","signature":"HttpPost = Callable[[str, Mapping[str, str], str], Awaitable[tuple[int, str]]]","returns":"injected seam: (url, headers, body) -> (status, body)"},
  {"name":"snapshot_deploy_ids","signature":"async def snapshot_deploy_ids(*, get: HttpGet | None = None) -> set[str]","returns":"the deploy ids Render already knows about, taken before pushing"},
  {"name":"push_target","signature":"async def push_target(*, runner: Runner | None = None) -> str","returns":"commit and push the target app; returns the pushed commit sha"},
  {"name":"await_deploy","signature":"async def await_deploy(commit_sha: str, known_ids: set[str], *, get: HttpGet | None = None, timeout_s: float = 900.0, interval_s: float = 10.0) -> PublishOutcome","returns":"poll until the deploy we caused reaches a terminal status"},
  {"name":"post_webhook","signature":"async def post_webhook(outcome: PublishOutcome, feature_ids: Sequence[str], *, post: HttpPost | None = None) -> bool","returns":"self-post the signed deploy webhook; True when accepted"},
  {"name":"publish","signature":"async def publish(feature_ids: Sequence[str], *, runner: Runner | None = None, get: HttpGet | None = None, post: HttpPost | None = None) -> PublishOutcome","returns":"push, await the deploy, then report it — the whole sequence"}
