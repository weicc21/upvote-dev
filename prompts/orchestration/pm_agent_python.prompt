<pdd-reason>The dedup gate. It decides whether a screened pitch is a new request, another vote for one that already exists, an extension of something shipped, or a request for something already built — so demand concentrates instead of scattering.</pdd-reason>

<pdd-interface>
{"type":"module","module":{"functions":[
  {"name":"Outcome","signature":"class Outcome(StrEnum)","returns":"new_unique, duplicate, extends_shipped, already_shipped"},
  {"name":"FeatureRef","signature":"@dataclass(frozen=True) class FeatureRef","returns":"id: str; title: str; description: str"},
  {"name":"Classification","signature":"@dataclass(frozen=True) class Classification","returns":"feature_id: str; outcome: Outcome; target_id: str | None; target_title: str | None; detail: str"},
  {"name":"classify","signature":"async def classify(pitch: Mapping[str, Any], *, backlog: Sequence[FeatureRef], shipped: Sequence[FeatureRef], judge: Judge | None = None) -> Classification","returns":"the dedup decision for one pitch; falls back to new_unique when no decision can be obtained"},
  {"name":"Judge","signature":"Judge = Callable[[str, str], Awaitable[str]]","returns":"injected seam: (system_prompt, user_prompt) -> raw model text"}
