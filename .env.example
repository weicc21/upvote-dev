# Supabase project settings — find these in your Supabase dashboard:
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-secret-service-key

# The table you want to test against, sanity only for setup test, not used by the app
SUPABASE_TABLE=your_table_name

# Redis connection (shared by the forum backend and the orchestrator).
# Start Redis with AOF persistence on — the feature_intake queue briefly holds
# the only copy of a pitch before it's screened and persisted to Postgres:
#   redis-server infrastructure/redis.conf   (or: redis-server --appendonly yes)
REDIS_URL=redis://localhost:6379

# Orchestrator: directory where the separate `streaks-demo` repo is mounted, i.e.
# the folder containing streaks_demo_typescriptreact.prompt. The orchestrator
# resolves the target prompt file as ${TARGET_PROMPT_DIR}/streaks_demo_typescriptreact.prompt
# and mutates it on compile. Set this to the actual mount path per deployment;
# the directory is never hardcoded in the generated code.
TARGET_PROMPT_DIR=/path/to/streaks-demo

# Orchestrator: the command the compiler_writer shells out to (as a subprocess,
# run inside TARGET_PROMPT_DIR) to regenerate the target app from its prompt.
# Hackathon default is the pdd CLI — pdd must be installed and `pdd auth`'d in the
# orchestrator environment (it internally uses PDD Cloud; append --local to run
# offline). Swap this one var to use a different compiler; the pipeline is otherwise
# compiler-agnostic.
COMPILE_COMMAND="pdd sync streaks_demo"

# Orchestrator LLM provider — OpenAI-compatible gateway (llm_client is the ONLY consumer).
# The hackathon uses MiniMax (sponsored credit). MiniMax exposes an OpenAI-compatible API, so
# the orchestrator talks to it through the `openai` SDK with a custom base_url — swapping to
# OpenAI, or Anthropic's OpenAI-compatible endpoint, is a base_url + key + model change and
# touches no phase module.
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=your-minimax-api-key
# Per-role model pins: classification-shaped screening/PM on a fast/cheap tier; reasoning-heavy
# architect on a stronger model (MiniMax-M3 has a 1M context if the target prompt grows large).
# Confirm the exact model strings your sponsored credit covers against the MiniMax model list.
LLM_MODEL_SCREENING=MiniMax-M2.5-highspeed
LLM_MODEL_PM=MiniMax-M2.5-highspeed
LLM_MODEL_ARCHITECT=MiniMax-M2.7
# Low temperature for deterministic, JSON-shaped verdicts (MiniMax range [0,2], default 1).
LLM_TEMPERATURE=0.2

#TokenRouter
TOKENROUTER_API_KEY="your-token-router-key"
TOKENROUTER_BASE_URL="https://api.tokenrouter.com/v1"

# Orchestrator: LLM-failure guardrails (bounded retries — sane defaults, override only if needed).
# MAX_INTAKE_ATTEMPTS   — how many times a Phase-1 batch may redeliver before it is
#                         dead-lettered to failed_intake:{batch_id} (Redis, 72h TTL) so a
#                         poison batch can't loop forever.
# MAX_ARCHITECT_ATTEMPTS — how many times a single feature may fail Phase 3 (revert to
#                         VOTING, re-qualify, fail again) before it is POSTPONED instead
#                         of looping the compile cycle.
MAX_INTAKE_ATTEMPTS=3
MAX_ARCHITECT_ATTEMPTS=2

# Ingestion daemon: BRPOP_TIMEOUT_SECONDS is how long the intake loop blocks on the
# feature_intake list before looping again. Its ONLY purpose is clean shutdown — the loop
# returns control periodically so a SIGINT is noticed within this window. It does NOT gate
# any threshold check (compilation is driven by the separate Sprint service, not the
# ingestion loop). See §8.5 of execution_playbook.md and § Service Topology in
# orchestration_python.prompt.
BRPOP_TIMEOUT_SECONDS=5

# Sprint service: the port the on-demand build trigger (FastAPI POST /sprint) listens on.
# Hit it with `curl -X POST localhost:8010/sprint` or a cron entry to run one build cycle
# (threshold gate -> Architect build spec -> pdd compile -> deploy). Operational endpoint
# only; not part of the frozen openapi.yaml forum contract.
SPRINT_SERVICE_PORT=8010

# Hackathon dev switch for the Forum Backend (default false = production behavior).
# When true, writes skip Supabase JWT verification and resolve the caller id from
# an X-Dev-User header (a UUID; falls back to a fixed anonymous-session UUID), and
# the Pitch Coins rate limit is bypassed — so curl can simulate many distinct
# voters/authors (see scripts/simulate_votes.sh). Spoofable by design; never enable
# in production.
DEV_MODE=false

# --- Render deploy webhook (POST /webhooks/render) ------------------------
# Shared secret the caller must send in the X-Webhook-Secret header; the backend
# rejects unsigned calls with 401. Your local deploy step self-POSTs the webhook
# and sends this same value (see infrastructure/deploy_webhook.prompt) — required
# by the endpoint, security-meaningless on localhost. Change it to any random string.
RENDER_WEBHOOK_SECRET=change-me-shared-secret

# Host allowlist for the sandbox preview_url — the webhook's preview_url and the
# /api/sandbox response are rejected unless the host matches. Comma-separated.
SANDBOX_ALLOWED_HOSTS=*.onrender.com

# Optional bootstrap sandbox URL shown before the first real deploy exists
# (GET /api/sandbox returns it as status:none). The compiled Streaks app on Render.
# SANDBOX_URL=https://streaks-demo.onrender.com

# --- Render deploy polling (local self-POST path — see infrastructure/deploy_webhook.prompt) ---
# DIFFERENT credential from RENDER_WEBHOOK_SECRET above:
#   RENDER_WEBHOOK_SECRET = you invent it; authenticates the webhook INTO your backend.
#   RENDER_API_KEY        = Render issues it; authenticates your calls OUT to Render's API
#                           (poll the deploy until status:live before you self-POST the webhook).
RENDER_API_KEY=your-render-api-key
RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx
# Optional: trigger a build via Render's Deploy Hook instead of `git push`
# (the URL embeds its own key — a third, separate credential).
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxx?key=yyyy

# --- Tunables (all OPTIONAL) ----------------------------------------------
# Each falls back to the matching DEFAULT_* constant in shared/constants.py when
# unset — see prompts/shared/config_python.prompt R2. Set one here only to
# override the default for this deployment. All must be positive integers;
# shared/config.py rejects zero or negative at import, not at first use.

# Pitch Coins: max pitches one author may submit per day (US-01).
# PITCH_COIN_LIMIT=5

# Upvotes a feature needs before it is eligible for a sprint (US-07).
# UPVOTE_THRESHOLD=10

# Seconds between sprint selection runs. 86400 = daily.
# SPRINT_CADENCE_SECONDS=86400

# Bounded architect/compiler retries before a feature is archived (US-08).
# MAX_RETRIES=3

# Seconds an author's pending pitch record survives in Redis before it expires
# (US-02, US-06). 900 = 15 minutes. Never reaches Postgres.
#
# The MVP never marks a pitch rejected — the record just expires — so this is also
# how long a rejected pitch keeps reading "screening" in its author's tray. Long
# enough that a slow screening pass never erases a live pitch, short enough that
# the stale state is gone before anyone reads it.
# PENDING_PITCH_TTL_SECONDS=900
